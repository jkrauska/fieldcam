    <style>
        .visually-hidden {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            border: 0;
        }

        /* Optional hover and focus styles */
        button:hover i,
        button:focus i {
            color: darkred;
        }

        .image-container {
            position: relative;
            display: flex;
            justify-content: center;
            /* Center horizontally */
            align-items: center;
            /* Center vertically */
            width: 100%;
            height: 100%;
            /* Adjust height as needed */
        }

        .image-text {
            position: absolute;
            color: white;
            font-size: 36px;
            text-align: center;
            /* Ensure the text itself is centered */
        }

        img {
            max-width: 100%;
            /* Ensure the image is responsive */
            max-height: 100%;
            /* Limit height to container */
        }
    </style>


    <!-- Set the page to refresh every XX seconds -->
    <meta http-equiv="refresh" content="900">
    <title>Live Stream</title>
</head>

