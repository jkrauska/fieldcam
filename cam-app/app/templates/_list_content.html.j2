{# Rendered inside a div with id="list-content" for Data-Star morphing. Used by list.html.j2 and by routes when returning patch HTML. #}
<div class="image-container">
    <img src="{{ request.base_url }}dynamic/field.jpg" alt="Field">
    <div class="image-text">{{ field_name }} Field</div>
</div>
<div class="text-center">
    Field Preview - Updated Every 5 minutes
</div>

{% if active_streams %}
<div class="mt-4" id="active-streams-section">
    <h4 class="text-danger">
        <i class="bi bi-broadcast-pin"></i> Live Streams
    </h4>
    <table class="table table-hover table-sm table-responsive table-bordered">
        <thead class="table-danger">
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Status</th>
                <th scope="col">Started</th>
                <th scope="col">Duration (min)</th>
                <th scope="col">Key</th>
                <th align="center" scope="col">Control</th>
            </tr>
        </thead>
        <tbody>
            {% for stream in active_streams %}
            <tr scope="row">
                <td>{{ stream.job_name | replace("SFLL ", "") | replace("Pirates Majors", "Majors Pirates") }}</td>
                <td>
                    <span class="badge bg-danger">
                        <i class="bi bi-circle-fill"></i> LIVE
                    </span>
                </td>
                <td>{{ stream.start_time_local | datetime('%Y-%m-%d %H:%M:%S') }}</td>
                <td>{{ (stream.duration / 60) | round | int }}</td>
                <td>
                    {% if stream.stream_key %}
                    <span class="d-inline-block stream-key" tabindex="0"
                        onclick="copyToClipboard('{{ stream.stream_key }}', this)"
                        data-bs-toggle="tooltip"
                        title="{{ stream.stream_key }}">
                        {{ stream.stream_key[13:][:6] }}...
                    </span>
                    {% else %}
                    N/A
                    {% endif %}
                </td>
                <td align="center">
                    <form action="/cancel_stream" method="post" data-on:submit="@post('/cancel_stream', {contentType: 'form'})">
                        <input type="hidden" name="name" value="{{ stream.job_name }}">
                        <button type="submit" style="border: none; background: none; cursor: pointer;">
                            <i class="bi bi-stop-circle-fill" style="font-size: 24px; color: red;"></i>
                            <span class="visually-hidden">Cancel Stream</span>
                        </button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% else %}
<div class="mt-4" id="active-streams-section"></div>
{% endif %}

<div class="mt-4" id="scheduled-jobs-section">
    <h4 class="text-primary">
        <i class="bi bi-calendar-event"></i> Scheduled Streams
    </h4>
    <table class="table table-hover table-sm table-responsive">
        <thead class="table-dark">
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Date</th>
                <th scope="col">Start</th>
                <th scope="col">Time</th>
                <th scope="col">Key</th>
                <th align="center" scope="col">Control</th>
            </tr>
        </thead>
        <tbody>
            {% for job in jobs %}
            {% if 'HIDDEN' not in job.id %}
            <tr scope="row">
                <td>{{ job.name | replace("SFLL ", "") | replace("Pirates Majors", "Majors Pirates") }}</td>
                <td>{{ job.next_run_time | datetime('%-m-%d-%y') }}</td>
                <td>{{ job.next_run_time | datetime('%H:%M:%S') }}</td>
                <td>
                    {% if job.kwargs.duration is defined %}
                    {{ (job.kwargs.duration / 60 )| round | int }}
                    {% else %}
                    N/A
                    {% endif %}
                </td>
                <td>
                    {% if job.kwargs.key is defined %}
                    <span class="d-inline-block stream-key" tabindex="0"
                        onclick="copyToClipboard('{{ job.kwargs.key }}', this)"
                        data-bs-toggle="tooltip"
                        title="{{ job.kwargs.key }}">
                        {{ job.kwargs.key[13:][:6] }}...
                    </span>
                    {% else %}
                    N/A
                    {% endif %}
                </td>
                <td align="center">
                    <form action="/remove_job" method="post" data-on:submit="@post('/remove_job', {contentType: 'form'})">
                        <input type="hidden" name="name" value="{{ job.name }}">
                        <input type="hidden" name="sure" value="yes">
                        <button type="submit" style="border: none; background: none; cursor: pointer;">
                            <i class="bi bi-x-octagon-fill" style="font-size: 24px; color: red;"></i>
                            <span class="visually-hidden">Remove job</span>
                        </button>
                    </form>
                </td>
            </tr>
            {% endif %}
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="d-flex container mt-5 justify-content-center gap-3">
    <a href="./add" class="btn btn-success btn-lg" style="padding: 20px 40px; font-size: 20px;">
        <i class="bi bi-plus-circle-fill" style="color: white; font-size: 1rem;"></i> Schedule A Stream
    </a>
    <a href="./list_all" class="btn btn-secondary btn-lg" style="padding: 20px 40px; font-size: 20px;">
        <i class="bi bi-clock-history" style="color: white; font-size: 1rem;"></i> View History
    </a>
</div>
