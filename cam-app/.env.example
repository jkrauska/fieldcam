# Fieldcam Configuration
# Copy this file to .env and fill in your values

# Security Settings (REQUIRED)
SECRET_KEY=your-secret-key-here
COOKIE_NAME=stream411_login

# Camera Configuration
CAMERA_USER=
CAMERA_PASS=

# Camera IP (auto-populated by discover-camera.sh)
CAMERA_IP=

# Application Settings
LOCATION=Tepper
LONG_STRING=your-long-string-here

# Authentication
# BCrypt hash for authentication (use bcrypt to generate)
AUTH_HASH_SFLL=$2b$12$your-bcrypt-hash-here
# Comma-separated list of passwords
PASSWORDS=password1,password2,password3
# Admin password (unlocks settings page)
ADMIN_PASSWORD=your-admin-password

# Blackout info (shown in schedule form warning)
BLACKOUT_SEASON=Spring 2026
BLACKOUT_TEAMS=TBD

# RTMP Base URLs (stream key is appended automatically)
RTMP_GAMECHANGER=rtmps://601c62c19c9e.global-contribute.live-video.net:443/app
RTMP_YOUTUBE=rtmp://a.rtmp.youtube.com/live2

# FFmpeg encode options (space-separated args, inserted after camera input)
VIDEO_OPTIONS=-c:v copy
AUDIO_OPTIONS=-af pan=mono|c0=c0 -c:a aac -ar 48000 -b:a 64k

# SRT caller latency buffer (ms). Written to srt:// URLs as latency=<us> (FFmpeg uses microseconds).
SRT_LATENCY_MS=3000

# Optional Settings
TIMEZONE=America/Los_Angeles
TOKEN_EXPIRY_MINUTES=30
JOBS_DB_PATH=sqlite:///jobs/jobs.sqlite
